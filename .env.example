# Copia este archivo como .env.local y completa los valores.
# Nunca escribas aquí la service role key de Supabase: solo vive en las Edge Functions.

# Muestra la ruta /guia-de-estilo fuera del modo desarrollo (true | false).
VITE_GUIA_ESTILO=false

# Fase 4 (Supabase): Project Settings → API Keys del proyecto (ver docs/BASE_DE_DATOS.md).
# Sin estas dos variables el panel muestra su página provisional.
# VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave publicable (sb_publishable_…) o, en proyectos antiguos, la anon key.
# VITE_SUPABASE_PUBLISHABLE_KEY=
